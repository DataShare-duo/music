{
  "name": "music",
  "description": "DataShare 个人音乐空间，微信云托管内测配置",
  "cpu": 1,
  "mem": 1,
  "minNum": 0,
  "maxNum": 1,
  "port": 80,
  "envParams": {
    "PORT": "80",
    "MUSIC_REQUEST_CONCURRENCY": "8",
    "MUSIC_REQUEST_RATE_PER_MINUTE": "120",
    "MUSIC_ACTION_RATE_PER_MINUTE": "20",
    "MUSIC_SEARCH_TASK_LIMIT": "2",
    "MUSIC_PROVIDER_QUEUE_SIZE": "4",
    "MUSIC_VERIFICATION_QUEUE_SIZE": "50",
    "MUSIC_STREAM_CONCURRENCY": "3",
    "MUSIC_STREAM_PER_IP": "3",
    "MUSIC_STREAM_PER_SESSION": "2",
    "MUSIC_STREAM_MAX_SECONDS": "900",
    "MUSIC_DATABASE_URL": "sqlite+aiosqlite:///data/music.db",
    "MUSIC_NETWORK_TIMEOUT": "12",
    "MUSIC_PROVIDER_CONCURRENCY": "2",
    "MUSIC_FALLBACK_SOURCES": "[\"netease\",\"kuwo\"]",
    "MUSIC_FULL_AUDIO_VERIFY_TIMEOUT": "30",
    "MUSIC_FULL_AUDIO_VERIFY_CONCURRENCY": "1",
    "MUSIC_FULL_AUDIO_RECHECK_INTERVAL": "21600",
    "MUSIC_CATALOG_TARGET": "100",
    "MUSIC_CATALOG_TTL": "21600",
    "MUSIC_SEARCH_TTL": "600",
    "MUSIC_FAILURE_COOLDOWN": "60",
    "MUSIC_PLAYBACK_TTL": "7200"
  }
}
