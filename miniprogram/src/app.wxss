page {
  background: #fbf8f3;
  color: #292b2a;
  font-size: 28rpx;
  font-family:
    system-ui,
    -apple-system,
    sans-serif;
}
button {
  font-size: 28rpx;
  margin: 0;
  border-radius: 20rpx;
  line-height: 2.6;
  background: transparent;
}
button::after {
  border: 0;
}
button[disabled] {
  opacity: 0.45;
}
text {
  word-break: break-word;
}
.page {
  padding: 36rpx 32rpx 60rpx;
}
.muted {
  color: #85877d;
  font-size: 24rpx;
}
.hint {
  color: #96968d;
  font-size: 22rpx;
  line-height: 1.7;
  display: block;
  margin-top: 14rpx;
}
.card {
  background: #fff;
  border: 1rpx solid #ebe6dd;
  border-radius: 24rpx;
  padding: 26rpx;
  margin-bottom: 26rpx;
}
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  gap: 12rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: 600;
}
.notice-title {
  font-weight: 600;
  margin-bottom: 10rpx;
}
.small {
  padding: 0 22rpx;
  font-size: 24rpx;
  white-space: nowrap;
  line-height: 2.7;
}
.outline {
  border: 1rpx solid #dcd5c9;
  color: #756c60;
}
.primary {
  background: #d66a42;
  color: #fff;
}
.song-title {
  font-weight: 600;
  font-size: 27rpx;
  display: block;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.event {
  font-size: 24rpx;
  line-height: 1.9;
  color: #6f7667;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f0ece5;
}
/* Native discovery and search */
.music-page {
  padding: 28rpx 30rpx 270rpx;
  box-sizing: border-box;
  max-width: 1100rpx;
  margin: 0 auto;
}
.brand-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: 12rpx 0 36rpx;
}
.brand-icon {
  width: 74rpx;
  height: 74rpx;
  border-radius: 50%;
  background: #d66a42;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}
.brand-copy {
  flex: 1;
}
.brand-name {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #30352b;
}
.brand-caption {
  display: block;
  font-size: 17rpx;
  letter-spacing: 3rpx;
  color: #9a9f8f;
  margin-top: 5rpx;
}
.about-button {
  font-size: 22rpx;
  line-height: 2.5;
  color: #8c917f;
  border: 1rpx solid #e4dfd3;
  padding: 0 18rpx;
}
.music-page .hero {
  position: relative;
  overflow: hidden;
  min-height: 420rpx;
  padding: 36rpx 30rpx;
  margin-bottom: 30rpx;
  background: #f0eadf;
  border-radius: 28rpx;
}
.music-page .eyebrow {
  display: block;
  color: #9b8b71;
  font-size: 17rpx;
  letter-spacing: 2.5rpx;
  line-height: 1.6;
}
.music-page .hero-title {
  position: relative;
  z-index: 2;
  white-space: pre-line;
  font-size: 56rpx;
  line-height: 1.3;
  letter-spacing: -1rpx;
  margin: 28rpx 0 18rpx;
  max-width: 100%;
  color: #30362b;
}
.hero-description {
  position: relative;
  z-index: 2;
  display: block;
  white-space: pre-line;
  color: #858979;
  font-size: 24rpx;
  line-height: 1.8;
  max-width: 88%;
}
.hero-action {
  position: relative;
  z-index: 2;
  display: inline-block;
  background: #6e795e;
  color: #fff;
  border-radius: 16rpx;
  font-size: 24rpx;
  line-height: 2.8;
  margin-top: 26rpx;
  padding: 0 24rpx;
}
.record-decoration {
  position: absolute;
  width: 255rpx;
  height: 255rpx;
  border-radius: 50%;
  right: -78rpx;
  bottom: -32rpx;
  background: repeating-radial-gradient(
    circle,
    #3d4437 0,
    #3d4437 4rpx,
    #46513f 5rpx,
    #35402f 8rpx
  );
  transform: rotate(-15deg);
  opacity: 0.9;
  display: flex;
  align-items: center;
  justify-content: center;
}
.record-core {
  background: #c7b89c;
  border: 10rpx solid #bbaa8d;
  color: #5a5748;
  font-size: 20rpx;
  padding: 24rpx;
  border-radius: 50%;
}
.record-caption {
  position: absolute;
  bottom: 20rpx;
  right: 22rpx;
  font-size: 14rpx;
  letter-spacing: 2rpx;
  color: #8b806b;
}
.navigation {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0 36rpx;
  margin-bottom: 10rpx;
  border-bottom: 1rpx solid #ece5d9;
}
.navigation-active {
  font-size: 27rpx;
  color: #4f5e40;
  font-weight: 600;
}
.navigation button {
  font-size: 25rpx;
  color: #8c917f;
  padding: 0;
  line-height: 2;
}
.navigation button text {
  color: #d66a42;
  margin-left: 16rpx;
}
.music-page .section-head {
  margin-top: 32rpx;
  margin-bottom: 24rpx;
}
.music-page .section-title {
  display: block;
  font-size: 33rpx;
  color: #343b2e;
  font-weight: 600;
  margin-top: 8rpx;
  line-height: 1.6;
}
.accent {
  color: #c47d58;
}
.section-note {
  font-size: 21rpx;
  color: #a3a593;
  font-style: italic;
  text-align: right;
  flex-shrink: 0;
}
.mood-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin-bottom: 32rpx;
}
.mood {
  border-radius: 20rpx;
  padding: 22rpx 18rpx;
  box-sizing: border-box;
  min-height: 162rpx;
  background: #eceee5;
}
.mood-symbol {
  display: block;
  font-size: 30rpx;
  margin-bottom: 12rpx;
}
.mood-title {
  display: block;
  font-weight: 600;
  font-size: 25rpx;
  color: #505b45;
}
.mood-label {
  display: block;
  font-size: 19rpx;
  margin-top: 6rpx;
  color: #8e9682;
}
.mood.green {
  background: #e8ede1;
  color: #7c8e68;
}
.mood.orange {
  background: #f4e7da;
  color: #bb8b62;
}
.mood.brown {
  background: #ede6d9;
  color: #998f6b;
}
.mood.pink {
  background: #f1e6e1;
  color: #b28a80;
}
.mood.blue {
  background: #e6ece9;
  color: #819a91;
}
.mood.sand {
  background: #efecde;
  color: #a39b6f;
}
.featured-scroll {
  width: 100%;
  white-space: nowrap;
  margin: 12rpx 0 16rpx;
}
.featured-row {
  display: inline-flex;
  gap: 22rpx;
  padding-bottom: 18rpx;
}
.featured-card {
  width: 260rpx;
  display: inline-block;
  white-space: normal;
}
.featured-cover {
  height: 260rpx;
  width: 260rpx;
  border-radius: 22rpx;
  overflow: hidden;
  position: relative;
}
.featured-number {
  position: absolute;
  top: 16rpx;
  left: 18rpx;
  font-size: 22rpx;
  color: #fff;
  text-shadow: 0 1rpx 6rpx #3338;
}
.featured-play {
  position: absolute;
  bottom: 18rpx;
  right: 18rpx;
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: #fffdf9e8;
  color: #6f775d;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.featured-title {
  display: block;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 26rpx;
  font-weight: 600;
  color: #3b4235;
  margin-top: 16rpx;
  line-height: 1.6;
}
.featured-artist {
  display: block;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 22rpx;
}
.music-page .list-heading {
  margin-bottom: 8rpx;
}
.music-page .compact {
  font-size: 22rpx;
  padding: 0 20rpx;
  border-radius: 14rpx;
  line-height: 2.8;
  flex-shrink: 0;
}
.count {
  font-size: 21rpx;
  font-weight: 400;
  color: #939b88;
  margin-left: 10rpx;
}
.list-caption {
  display: block;
  color: #a2a694;
  font-size: 21rpx;
  line-height: 1.6;
  margin-bottom: 22rpx;
}
.list-status {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  font-size: 22rpx;
  color: #929b84;
  line-height: 1.8;
  margin: 8rpx 0 18rpx;
}
.status-dot {
  font-size: 16rpx;
  line-height: 2.5;
  color: #bdac77;
}
.song-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 24rpx 2rpx;
  border-bottom: 1rpx solid #ece7db;
  box-sizing: border-box;
  min-height: 132rpx;
}
.song-row.selected {
  background: #f0f1e9;
  border-radius: 16rpx;
  padding-left: 10rpx;
  padding-right: 10rpx;
  border-color: transparent;
}
.song-number {
  width: 30rpx;
  font-size: 21rpx;
  color: #a0a590;
  flex-shrink: 0;
  text-align: center;
}
.selected .song-number,
.selected .song-name {
  color: #718253;
}
.song-cover {
  width: 84rpx;
  height: 84rpx;
  border-radius: 17rpx;
  overflow: hidden;
  flex-shrink: 0;
}
.song-detail {
  flex: 1;
  min-width: 0;
}
.song-name {
  display: block;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  color: #424a36;
  font-weight: 600;
  font-size: 25rpx;
  line-height: 1.7;
}
.song-artist {
  display: block;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 21rpx;
  color: #919882;
  line-height: 1.6;
}
.song-extra {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 18rpx;
  margin-top: 3rpx;
}
.song-album {
  color: #a9ad9c;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  max-width: 55%;
}
.source-tag {
  color: #8f987b;
  flex-shrink: 0;
}
.song-tail {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  width: 56rpx;
  font-size: 20rpx;
  color: #a0a78f;
  flex-shrink: 0;
}
.row-play {
  color: #9aa687;
  font-size: 21rpx;
}
.list-footnote {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 26rpx 0;
  font-size: 20rpx;
  color: #adb09e;
}
.music-page .empty {
  padding: 60rpx 16rpx;
  gap: 12rpx;
  text-align: center;
}
.empty-disc {
  width: 104rpx;
  height: 104rpx;
  border: 2rpx solid #d9ddce;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f0f1e9;
  color: #a3ae8e;
  font-size: 52rpx;
  margin-bottom: 12rpx;
}
.empty-title {
  font-weight: 600;
  color: #828b70;
  font-size: 26rpx;
}
.empty .muted {
  font-size: 22rpx;
  line-height: 1.8;
}
.error-box {
  display: flex;
  align-items: center;
  gap: 16rpx;
  border: 1rpx solid #eedbd0;
  background: #f8efe7;
  color: #b27150;
  padding: 20rpx;
  border-radius: 16rpx;
  font-size: 23rpx;
  line-height: 1.7;
  margin: 20rpx 0;
}
.error-box text {
  flex: 1;
}
.retry {
  font-size: 23rpx;
  padding: 0 16rpx;
  color: #a86a4b;
  flex-shrink: 0;
}
.footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  margin-top: 28rpx;
  border-top: 1rpx solid #eae5d9;
  padding: 32rpx 0 14rpx;
  font-size: 19rpx;
  color: #adb19e;
}
.footer-logo {
  font-size: 21rpx;
  letter-spacing: 2rpx;
  color: #929c80;
  margin-bottom: 6rpx;
}
.search-heading {
  padding: 22rpx 0 34rpx;
}
.page-title {
  display: block;
  font-size: 44rpx;
  line-height: 1.5;
  font-weight: 600;
  color: #3d4632;
  margin: 20rpx 0 12rpx;
}
.search-heading .muted {
  font-size: 24rpx;
}
.search-card {
  background: #fffdf9;
  border: 1rpx solid #ebe5d8;
  border-radius: 24rpx;
  overflow: hidden;
}
.search-input-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 18rpx;
}
.search-symbol {
  font-size: 42rpx;
  color: #a4ac93;
  margin-left: 2rpx;
}
.search-input-row input {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  height: 64rpx;
  line-height: 64rpx;
  color: #4a543b;
}
.clear-input {
  padding: 0 8rpx;
  color: #aeb29f;
  font-size: 36rpx;
  line-height: 1.6;
}
.search-submit {
  font-size: 24rpx;
  padding: 0 24rpx;
  border-radius: 14rpx;
  line-height: 2.6;
  flex-shrink: 0;
}
.source-selector {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 24rpx;
  border-top: 1rpx solid #f0ece2;
  color: #a5ac95;
  font-size: 22rpx;
}
.source-selector view {
  display: flex;
  gap: 22rpx;
  color: #7f8d6a;
}
.chevron {
  color: #a6ad96;
}
.suggestions {
  padding-top: 34rpx;
}
.suggestion-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 22rpx;
}
.suggestion-chips button {
  background: #efeee5;
  color: #879174;
  font-size: 23rpx;
  line-height: 2.8;
  border-radius: 15rpx;
  padding: 0 20rpx;
}
.suggestion-chips button text {
  margin-left: 18rpx;
  color: #a4aa94;
}
.search-page-number {
  font-size: 21rpx;
  color: #9ba58b;
}
.modal-mask {
  position: fixed;
  inset: 0;
  z-index: 30;
  background: #20261e66;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 36rpx;
}
.about-panel {
  background: #fffdf9;
  border-radius: 28rpx;
  padding: 36rpx;
  max-width: 640rpx;
  box-sizing: border-box;
  width: 100%;
}
.about-description {
  display: block;
  font-size: 27rpx;
  color: #808c70;
  line-height: 1.9;
  white-space: pre-line;
  margin: 20rpx 0;
}
.about-panel .muted {
  display: block;
  white-space: pre-line;
  font-size: 22rpx;
  line-height: 1.9;
}
.about-panel button {
  margin-top: 20rpx;
}
.about-panel .primary {
  background: #72835b;
  color: #fff;
}
.about-panel .outline {
  color: #879675;
  border-color: #dce3d2;
}
