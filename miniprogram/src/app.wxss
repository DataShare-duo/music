page{background:#fbf8f3;color:#292b2a;font-size:28rpx;font-family:system-ui,-apple-system,sans-serif}button{font-size:28rpx;margin:0;border-radius:20rpx;line-height:2.6;background:transparent}button::after{border:0}button[disabled]{opacity:.45}text{word-break:break-word}.page{padding:36rpx 32rpx 330rpx}.brand{display:flex;align-items:center;gap:18rpx;margin:12rpx 0 38rpx}.brand-mark{width:72rpx;height:72rpx;border-radius:50%;background:#d66a42;color:white;font-size:48rpx;display:flex;align-items:center;justify-content:center}.brand-title{font-size:42rpx;font-weight:700;display:block}.brand-sub{font-size:17rpx;letter-spacing:3rpx;color:#96968d}.pill{margin-left:auto;border:1rpx solid #e0d4c3;padding:9rpx 14rpx;border-radius:30rpx;font-size:20rpx;color:#81715f}.hero{padding:40rpx 34rpx;border-radius:28rpx;background:#f0eadf;margin-bottom:30rpx}.eyebrow{font-size:18rpx;letter-spacing:3rpx;color:#89765e}.hero-title{display:block;white-space:pre-line;font-size:64rpx;line-height:1.35;font-weight:700;margin:24rpx 0}.hero-text{font-size:25rpx;color:#77776c;line-height:1.8}.notice{background:#fff4e7;border:1rpx solid #e8d7bf;padding:24rpx;border-radius:20rpx;color:#826441;font-size:24rpx;line-height:1.8;margin-bottom:26rpx}.notice text,.acceptance text{display:block}.notice-title{font-weight:600;margin-bottom:10rpx}.card{background:#fff;border:1rpx solid #ebe6dd;border-radius:24rpx;padding:26rpx;margin-bottom:26rpx}.section-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:20rpx;gap:12rpx}.section-title{font-size:32rpx;font-weight:600}.section-title .muted{font-size:23rpx;font-weight:400}.small{padding:0 22rpx;font-size:24rpx;white-space:nowrap;line-height:2.7}.outline{border:1rpx solid #dcd5c9;color:#756c60}.primary{background:#d66a42;color:#fff}.muted{color:#85877d;font-size:24rpx}.hint{color:#96968d;font-size:22rpx;line-height:1.7;display:block;margin-top:14rpx}.tabs{display:flex;gap:12rpx;margin-bottom:22rpx}.tab{color:#8b8c81;padding:0 24rpx}.tab.active{background:#f0eadf;color:#3e4239;font-weight:600}.search-row{display:flex;gap:14rpx;align-items:center}.search-row input{flex:1;min-width:0;background:#f7f5f0;border-radius:14rpx;padding:20rpx;font-size:27rpx}.source-picker{display:flex;justify-content:space-between;color:#7f806f;font-size:24rpx;padding:22rpx 2rpx 0}.song{display:flex;align-items:center;gap:18rpx;padding:26rpx 0;border-bottom:1rpx solid #ebe6dd}.cover{width:76rpx;height:76rpx;flex-shrink:0;border-radius:18rpx;background:#eee9df;color:#aa9a83;display:flex;align-items:center;justify-content:center;font-size:38rpx}.song-meta{flex:1;min-width:0}.song-meta text{display:block}.song-title{font-weight:600;font-size:27rpx;display:block;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.song-album{font-size:21rpx;color:#a2a295;margin-top:6rpx;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.song-play{font-size:25rpx;color:#d66a42}.empty{display:flex;flex-direction:column;align-items:center;text-align:center;padding:60rpx 20rpx;color:#848779}.empty-icon{font-size:72rpx;margin-bottom:20rpx}.list-message{display:block;margin-bottom:12rpx}.error{background:#fbece5;border-radius:14rpx;padding:22rpx;color:#ad5438;font-size:24rpx;line-height:1.7;margin-bottom:16rpx}.error-text{color:#ad5438!important}.pagination{display:flex;align-items:center;justify-content:space-between;margin:26rpx 0}.acceptance{margin-top:32rpx;line-height:1.9;color:#737768;font-size:25rpx}.acceptance button{margin-top:18rpx}.footer{font-size:21rpx;color:#a6a494;text-align:center;padding:20rpx}.player{position:fixed;bottom:0;left:0;right:0;background:#fffdf9;border-top:1rpx solid #e6e0d6;padding:22rpx 32rpx 20rpx;box-shadow:0 -6rpx 30rpx #55551108}.safe-bottom{padding-bottom:calc(20rpx + env(safe-area-inset-bottom))}.player-info{max-width:100%;padding-right:230rpx;min-height:70rpx}.player-info .muted{display:block;margin-top:6rpx}.controls{position:absolute;right:24rpx;top:20rpx;display:flex;align-items:center;gap:8rpx}.controls button{width:60rpx;padding:0;font-size:26rpx;color:#777b6e}.controls .main-play{background:#d66a42;color:#fff;border-radius:50%;width:68rpx;height:68rpx;line-height:68rpx}.progress{display:flex;align-items:center;font-size:21rpx;color:#989b8d;margin-top:6rpx}.progress slider{flex:1;margin:12rpx 20rpx}.player-message{display:block;font-size:22rpx;color:#8b8e7e;line-height:1.5;margin-top:4rpx}.event{font-size:24rpx;line-height:1.9;color:#6f7667;padding:14rpx 0;border-bottom:1rpx solid #f0ece5}.diagnostic-player{padding:0 32rpx}
