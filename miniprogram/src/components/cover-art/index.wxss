:host {
  display: block;
  width: 100%;
  height: 100%;
}
.art {
  width: 100%;
  height: 100%;
  overflow: hidden;
  border-radius: inherit;
  background: #ece7dc;
}
.art image {
  width: 100%;
  height: 100%;
  display: block;
}
.placeholder {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  background: linear-gradient(145deg, #e8e2d4, #d7d1c1);
  color: #8d907d;
}
.placeholder text {
  font-size: 52rpx;
  position: relative;
  z-index: 1;
}
.groove {
  position: absolute;
  width: 68%;
  height: 68%;
  border: 2rpx solid #aaa99244;
  border-radius: 50%;
  box-shadow:
    0 0 0 12rpx #aaa99211,
    0 0 0 24rpx #aaa99211;
}
