.bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 15;
  background: #fffdf9;
  border-top: 1rpx solid #e8e1d6;
  padding: 24rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -10rpx 36rpx #3b3b2b08;
}
.main {
  display: flex;
  align-items: center;
  gap: 18rpx;
}
.cover {
  width: 76rpx;
  height: 76rpx;
  border-radius: 16rpx;
  overflow: hidden;
  flex-shrink: 0;
}
.meta {
  flex: 1;
  min-width: 0;
}
.title {
  display: block;
  font-size: 25rpx;
  font-weight: 600;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  color: #33372f;
}
.artist {
  display: block;
  font-size: 20rpx;
  color: #8c9182;
  margin-top: 8rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.controls {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.controls button {
  padding: 0;
  margin: 0;
  width: 42rpx;
  height: 64rpx;
  line-height: 64rpx;
  color: #7b826d;
  background: transparent;
  border-radius: 50%;
  font-size: 23rpx;
}
.controls button::after {
  border: 0;
}
.controls .play {
  width: 66rpx;
  height: 66rpx;
  line-height: 66rpx;
  color: #fff;
  background: #d66a42;
  font-size: 29rpx;
}
.controls button[disabled] {
  opacity: 0.45;
}
.progress {
  display: flex;
  align-items: center;
  color: #9b9d90;
  font-size: 20rpx;
  margin-top: 6rpx;
}
.progress slider {
  flex: 1;
  margin: 16rpx 18rpx;
}
.message {
  display: block;
  font-size: 22rpx;
  color: #8c927f;
  line-height: 1.55;
  margin-top: 2rpx;
}
.message.error {
  color: #b05b42;
}
