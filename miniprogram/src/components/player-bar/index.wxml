<view class="bar"><view class="main"><view class="cover"><cover-art url="{{cover}}" title="{{title}}"/></view><view class="meta"><text class="title">{{title}}</text><text class="artist">{{artist}}<text wx:if="{{source}}"> · {{source}}</text></text></view><view class="controls"><button aria-label="上一首" disabled="{{!hasSong || loading}}" bindtap="previous">◀</button><button aria-label="{{playing ? '暂停' : '播放'}}" class="play" disabled="{{!hasSong || (loading && !failed)}}" bindtap="toggle">{{loading ? '···' : (playing ? 'Ⅱ' : '▶')}}</button><button aria-label="下一首" disabled="{{!hasSong || loading}}" bindtap="next">▶</button></view></view><view class="progress"><text>{{positionText}}</text><slider aria-label="播放进度" min="0" max="{{duration || 1}}" value="{{position}}" step="0.1" disabled="{{!duration || loading}}" bindchange="seek" activeColor="#d66a42" backgroundColor="#e8e1d8" block-size="12"/><text>{{durationText}}</text></view><text wx:if="{{message && (loading || failed || queueEnded)}}" class="message {{failed ? 'error' : ''}}">{{message}}</text></view>
