<view class="full-player"><view class="backdrop"><image wx:if="{{coverUrl && !coverBroken}}" class="background-cover" src="{{coverUrl}}" mode="aspectFill" binderror="coverFailed"/><view class="background-fallback" wx:else></view><view class="background-shade"></view></view>
<view class="full-header" style="padding-top:{{statusTop}}px;padding-right:{{headerRight}}px"><button class="collapse" aria-label="返回音乐页面" bindtap="back">⌄</button><view class="header-copy"><text>听见 · 此刻正在听</text><text class="header-en">LISTEN & FEEL</text></view></view>
<view class="track-info"><text class="full-title">{{title}}</text><text class="full-artist">{{artist}}</text><text wx:if="{{sourceName}}" class="full-source">{{sourceName}}</text></view>
<view class="lyrics-region"><scroll-view wx:if="{{lyricStatus === 'synced'}}" class="lyric-scroll" scroll-y="{{true}}" scroll-top="{{lyricScrollTop}}" scroll-with-animation="{{following}}" show-scrollbar="{{false}}" bindtouchstart="manualStart" bindtouchend="manualEnd" bindtouchcancel="manualEnd" bindscroll="manualScroll"><view class="lyric-spacer"></view><view wx:for="{{lyricLines}}" wx:key="time_ms" id="lyric-line-{{index}}" class="lyric-line {{activeIndex === index ? 'active-line' : ''}}"><text>{{item.text}}</text></view><view class="lyric-spacer"></view></scroll-view>
<scroll-view wx:elif="{{lyricStatus === 'plain'}}" scroll-y="{{true}}" class="lyric-scroll" show-scrollbar="{{false}}"><text class="plain-label">音源未提供歌词时间轴</text><text class="plain-lyrics">{{plainText}}</text></scroll-view>
<view wx:else class="lyric-empty"><text class="lyric-symbol">{{lyricStatus === 'loading' ? '···' : '♫'}}</text><text class="lyric-empty-title">{{lyricMessage || '暂无歌词'}}</text><text wx:if="{{lyricStatus === 'unavailable'}}" class="lyric-note">暂未提供歌词，让旋律陪你一会儿</text><text wx:if="{{lyricStatus === 'instrumental'}}" class="lyric-note">此刻，只听旋律</text><button wx:if="{{lyricStatus === 'error'}}" class="lyric-retry" disabled="{{retryAfter > 0}}" bindtap="retryLyrics">{{retryAfter > 0 ? '稍后可重试' : '重试获取歌词'}}</button></view>
<button wx:if="{{lyricStatus === 'synced' && !following}}" class="follow-lyrics" bindtap="followLyrics">↟ 回到当前歌词</button></view>
<view class="full-controls"><text wx:if="{{lyricSource}}" class="lyric-credit">歌词来源 · {{lyricSource}}</text><view class="full-progress"><text>{{positionText}}</text><slider min="0" max="{{duration || 1}}" value="{{position}}" step="0.1" disabled="{{!duration || loading}}" bindchange="seek" activeColor="#ffffff" backgroundColor="#ffffff30" block-size="12"/><text>{{durationText}}</text></view><view class="full-buttons"><button aria-label="上一首" disabled="{{!hasSong || loading}}" bindtap="previous">◀</button><button class="full-play" aria-label="{{playing ? '暂停' : '播放'}}" disabled="{{!hasSong || (loading && !failed)}}" bindtap="toggle">{{loading ? '···' : (playing ? 'Ⅱ' : '▶')}}</button><button aria-label="下一首" disabled="{{!hasSong || loading}}" bindtap="next">▶</button></view><text wx:if="{{message && (loading || failed || queueEnded)}}" class="full-message">{{message}}</text><text wx:else class="full-footnote">给生活，留一点音乐的时间</text></view></view>
