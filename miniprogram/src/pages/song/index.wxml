
<view class="music-page"><text class="eyebrow">A SONG FOR YOU</text><text class="section-title">与你分享一首歌</text><view class="shared-art"><cover-art url="{{cover}}" title="{{title}}"/></view><text class="shared-title">{{title}}</text><text class="shared-artist">{{artist}}</text><text wx:if="{{message}}" class="shared-message">{{message}}</text><view wx:if="{{limited}}"><text class="shared-message">当前为朋友圈单页浏览，请使用微信提供的入口进入完整小程序后播放</text></view><button wx:else class="primary" bindtap="play" disabled="{{loading}}">{{loading ? '正在验证…' : (ready ? '播放分享歌曲' : '重试验证歌曲')}}</button><button class="outline shared-home" bindtap="home">发现更多音乐</button></view><player-bar/>
