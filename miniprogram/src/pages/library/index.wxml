
<view class="music-page"><view class="section-head"><view><text class="eyebrow">KEEP YOUR MELODIES</text><text class="section-title">{{title}} <text class="count">{{total}} 首</text></text></view><button wx:if="{{kind === 'recent' && total}}" class="history-clear" bindtap="clearRecent">清空</button></view>
 <text wx:if="{{error}}" class="hint">{{error}}</text><text wx:if="{{message}}" class="hint">{{message}}</text>
 <view wx:if="{{!items.length}}" class="empty"><view class="empty-disc">♪</view><text class="empty-title">这里还没有歌曲</text><text class="muted">{{kind === 'recent' ? '真正开始播放的歌曲才会出现在这里' : '在全屏播放器中留下你喜欢的旋律'}}</text></view>
 <view class="song-list"><view wx:for="{{items}}" wx:key="key" class="song-row"><view class="song-cover" data-key="{{item.key}}" bindtap="play"><cover-art url="{{item.song.cover_url}}" title="{{item.song.title}}"/></view><view class="song-detail" data-key="{{item.key}}" bindtap="play"><text class="song-name">{{item.song.title}}</text><text class="song-artist">{{item.song.artist}}</text><text class="hint">{{kind === 'recent' ? item.timeText : item.song.album}}</text><text class="hint">{{item.availability}}</text><text wx:if="{{kind === 'recent' && item.sourceName}}" class="hint">{{item.sourceName}}</text></view><button class="history-clear" data-key="{{item.key}}" bindtap="remove">{{kind === 'recent' ? '删除' : '取消'}}</button></view></view>
 <view wx:if="{{total > 20}}" class="pagination"><button class="page-button" disabled="{{page <= 1}}" bindtap="previous">上一页</button><text class="page-current">{{page}}</text><button class="page-button page-button-next" disabled="{{!hasMore}}" bindtap="next">下一页</button></view>
</view><player-bar/>
