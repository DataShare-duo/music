<view class="music-page search-page">
  <view class="search-heading"><text class="eyebrow">FIND YOUR NEXT FAVORITE</text><text class="page-title">找到心里的那首歌。</text><text class="muted">歌名、歌手，或一句想念</text></view>
  <view class="search-card"><view class="search-input-row"><text class="search-symbol">⌕</text><input value="{{query}}" bindinput="input" bindconfirm="search" placeholder="搜索歌名、歌手" confirm-type="search" maxlength="100"/><button wx:if="{{query}}" class="clear-input" bindtap="clear" aria-label="清空搜索">×</button><button class="primary search-submit" bindtap="search">搜索</button></view><picker mode="selector" range="{{sourceNames}}" value="{{sourceIndex}}" bindchange="sourceChange"><view class="source-selector"><text>音乐来源</text><view><text>{{sourceNames[sourceIndex]}}</text><text class="chevron">⌄</text></view></view></picker></view>
  <view wx:if="{{searchHistory.length}}" class="history-section"><view class="section-head"><text class="history-title">历史搜索</text><button class="history-clear" bindtap="clearSearchHistory">清空</button></view><view class="history-chips"><view wx:for="{{searchHistory}}" wx:key="key" class="history-chip"><text data-query="{{item.query}}" bindtap="historySearch">{{item.query}}</text><button data-key="{{item.key}}" catchtap="removeSearch" aria-label="删除这条搜索">×</button></view></view></view><text wx:if="{{personalError}}" class="hint">{{personalError}}</text>
  <view wx:if="{{!searched}}" class="suggestions"><text class="section-title">从这里开始听</text><view class="suggestion-chips"><button wx:for="{{moods}}" wx:key="title" data-query="{{item.title}}" bindtap="mood">{{item.title}} <text>↗</text></button></view><view class="empty"><view class="empty-disc">♫</view><text class="empty-title">每一种心情，都有一段旋律</text><text class="muted">输入关键词，发现喜欢的音乐</text></view></view>
  <view wx:if="{{error}}" class="error-box"><text>{{error}}</text><button wx:if="{{searched}}" class="retry" bindtap="retry" disabled="{{loading}}">重试</button></view>
  <block wx:if="{{searched}}"><view class="section-head list-heading"><view><text class="eyebrow">SEARCH RESULTS</text><text class="section-title">搜索结果 <text class="count">{{items.length}} 首</text></text></view><text class="search-page-number">第 {{page}} 页</text></view><text class="list-caption">“{{searched}}” · {{sourceNames[sourceIndex]}}</text><view wx:if="{{refreshing || message || stale}}" class="list-status"><text wx:if="{{refreshing}}" class="status-dot">●</text><text>{{message || (refreshing ? '正在验证可播放歌曲' : '')}}</text><text wx:if="{{stale}}"> · 缓存结果</text></view>
  <view wx:if="{{!items.length}}" class="empty"><view class="empty-disc">♪</view><text class="empty-title">{{loading || refreshing ? '正在验证可播放歌曲' : '暂未找到可确认完整版的歌曲'}}</text><text class="muted">{{loading || refreshing ? '验证通过后逐步展示，无需重复搜索' : '可以换个关键词或音乐来源，系统也会定期重新检查'}}</text></view>
  <view class="song-list"><view wx:for="{{items}}" wx:key="id" class="song-row {{currentId === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="playSong"><text class="song-number">{{currentId === item.id && playing ? '♫' : item.number}}</text><view class="song-cover"><cover-art url="{{item.cover_url}}" title="{{item.title}}"/></view><view class="song-detail"><text class="song-name">{{item.title}}</text><text class="song-artist">{{item.artist}}</text><view class="song-extra"><text class="song-album">{{item.album || '—'}}</text><text class="source-tag">{{item.sourceText}}</text></view></view><view class="song-tail"><text>{{item.durationText}}</text><text class="row-play">{{currentId === item.id && playing ? 'Ⅱ' : '▶'}}</text></view></view></view>
  <view class="pagination">
    <button class="page-button" hover-class="page-button-pressed" disabled="{{page <= 1 || loading}}" bindtap="previousPage"><text class="page-arrow">‹</text><text>上一页</text></button>
    <view class="page-indicator"><text class="page-indicator-label">第</text><text class="page-current">{{page}}</text><text class="page-indicator-label">页</text></view>
    <button class="page-button page-button-next" hover-class="page-button-pressed" disabled="{{!hasMore || loading}}" bindtap="nextPage"><text>下一页</text><text class="page-arrow">›</text></button>
  </view></block>
  <view class="footer"><text>作者：DataShare · 仅供个人非商业使用</text></view>
</view><player-bar/>
